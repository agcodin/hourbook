rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own categories and entries.
    match /users/{uid}/{kind}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && kind in ['categories', 'entries'];
    }
  }
}
